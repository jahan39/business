# ── The Sugar Atelier — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# ── Email Providers (Configure either Gmail SMTP or Resend) ────────────
# Option 1: Gmail SMTP (Recommended: sends to ANY email address, no custom domain needed)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Option 2: Resend (transactional email API)
# Get your API key at https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# Display name shown in the From field
EMAIL_FROM_NAME=The Sugar Atelier

# ── OTP Security Settings ─────────────────────────────────────────────
# OTP valid duration in minutes (default: 10)
OTP_EXPIRY_MINUTES=10

# Maximum wrong-OTP attempts before the token is invalidated (default: 5)
OTP_MAX_ATTEMPTS=5

# Minimum seconds between OTP resend requests for the same email (default: 60)
OTP_RESEND_COOLDOWN_SECONDS=60

# Maximum OTP send requests per email within a rolling 1-hour window (default: 5)
OTP_MAX_SENDS_PER_HOUR=5

# ── Firebase Admin SDK ────────────────────────────────────────────────
# Download the service account key JSON from:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then either:
#   (a) Save the file as serviceAccountKey.json in the project root (git-ignored), OR
#   (b) Set the three variables below (recommended for production/cloud environments)

FIREBASE_PROJECT_ID=sugar-atelier-46ffa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sugar-atelier-46ffa.iam.gserviceaccount.com

# Paste the private key value from the JSON. Keep the quotes and \n escape sequences.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Server ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Support email shown in verification emails
SUPPORT_EMAIL=support@yourdomain.com
